# CDF Wallet — Environment Variables Template
# STRICT NON-CUSTODIAL RULE: Never put private keys, seed phrases or custodial secrets here!

# AI Studio Standard Variables
GEMINI_API_KEY=""
APP_URL=""

# Blockchain RPC Endpoints (Optional public/private fallback RPCs)
VITE_BSC_MAINNET_RPC="https://bsc-dataseed.binance.org"
VITE_BSC_TESTNET_RPC="https://data-seed-prebsc-1-s1.binance.org:8545"

# Supabase (Optional non-sensitive cloud sync for preferences, non-sensitive profiles)
